# Production settings for infrastructure/docker-compose.prod.yml.
#
# Copy to infrastructure/.env.production, fill in, and keep it OFF git — this
# file holds every secret the system has. docs/deployment.md explains each one.
#
# Generate each secret on the server, never reuse one from somewhere else:
#   openssl rand -hex 32        (JWT secrets, passwords: base64's / and + would
#                                break the database address built from them)
#   openssl rand -base64 32     (FIELD_ENCRYPTION_KEY — exactly 32 bytes)

# ── Addresses ────────────────────────────────────────────────────────────────
# Both must already point at this server in DNS before the first start, or
# Caddy cannot obtain their HTTPS certificates.
APP_DOMAIN=cheques.example.com
FILES_DOMAIN=files.cheques.example.com

# ── Database ─────────────────────────────────────────────────────────────────
POSTGRES_USER=chequeflow
POSTGRES_PASSWORD=
POSTGRES_DB=chequeflow

# ── Sessions ─────────────────────────────────────────────────────────────────
# Two different values. The API refuses to start if they match.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Account-number encryption ───────────────────────────────────────────────
# KEEP A COPY OF THIS SOMEWHERE OTHER THAN THIS SERVER. Account numbers are
# encrypted with it, inside the database and inside every backup. Lose it and
# they cannot be read again by anyone; restore a backup on a server with a
# different key and the restore is refused.
FIELD_ENCRYPTION_KEY=

# ── Cheque image storage ─────────────────────────────────────────────────────
S3_ACCESS_KEY_ID=chequeflow
S3_SECRET_ACCESS_KEY=
S3_BUCKET=cheque-images

# ── Reading cheques (OCR) ────────────────────────────────────────────────────
# disabled, claude or google. There is no default: the API refuses to start on
# the mock provider in production, because it invents the figures it "reads".
# disabled means manual entry only and needs no key. For claude, add
# ANTHROPIC_API_KEY=... below.
OCR_PROVIDER=disabled

# ── Reminders on the phone ───────────────────────────────────────────────────
PUSH_ENABLED=true
