# Settings for scripts/server-backup.sh and scripts/server-restore.sh.
#
# Copy to infrastructure/.env.backup and keep it OFF git. docs/deployment.md
# explains each value.

# Where backups go. Off this server: a backup that dies with it is not one.
# Cloudflare R2: s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<BUCKET>
RESTIC_REPOSITORY=

# Encrypts every backup before it leaves the server. Generate it with
# `openssl rand -hex 32`. KEEP A COPY OFF THIS SERVER: without it no backup can
# ever be opened, by anyone.
RESTIC_PASSWORD=

# The bucket's access key.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# R2 uses "auto" as its region.
AWS_DEFAULT_REGION=auto

# Optional: opened after each successful backup, so a service such as
# healthchecks.io can alert you when one does not arrive.
BACKUP_PING_URL=
