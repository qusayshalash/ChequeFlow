# ─────────────────────────────────────────────────────────────────────────────
# ChequeFlow — example environment file.
# Copy to `.env` and replace every value. NEVER commit a real `.env`.
#   cp .env.example .env
# Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Local infrastructure (docker compose) ───────────────────────────────────
POSTGRES_USER=chequeflow
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=chequeflow
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_ROOT_USER=chequeflow
MINIO_ROOT_PASSWORD=change_me_local_only
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Database ────────────────────────────────────────────────────────────────
# Must match the POSTGRES_* values above when using docker compose.
DATABASE_URL=postgresql://chequeflow:change_me_local_only@localhost:5432/chequeflow?schema=public
# Separate database used by integration tests (created by `pnpm test:setup`).
TEST_DATABASE_URL=postgresql://chequeflow:change_me_local_only@localhost:5432/chequeflow_test?schema=public

# ── Redis / background jobs ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── API ─────────────────────────────────────────────────────────────────────
API_PORT=3333
API_GLOBAL_PREFIX=api
# Comma separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
# Trust the X-Forwarded-For header (enable only behind a known proxy).
TRUST_PROXY=false

# ── Authentication ──────────────────────────────────────────────────────────
# openssl rand -base64 48
JWT_ACCESS_SECRET=replace_me_with_a_long_random_string
JWT_REFRESH_SECRET=replace_me_with_a_different_long_random_string
JWT_ACCESS_TTL=900          # seconds (15 minutes)
JWT_REFRESH_TTL=2592000     # seconds (30 days)
JWT_ISSUER=cheque-flow
JWT_AUDIENCE=cheque-flow-clients

# 32-byte key, base64 encoded — encrypts bank account numbers and IBANs.
# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=replace_me_with_a_base64_32_byte_key

# ── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_OCR_PER_MINUTE=20
RATE_LIMIT_DEFAULT_PER_MINUTE=120

# ── Object storage (S3 compatible; MinIO locally) ───────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=cheque-images
S3_ACCESS_KEY_ID=chequeflow
S3_SECRET_ACCESS_KEY=change_me_local_only
# Required by MinIO; set to false for AWS S3.
S3_FORCE_PATH_STYLE=true
# Lifetime of the signed image URLs, in seconds.
S3_SIGNED_URL_TTL=300
MAX_UPLOAD_SIZE_BYTES=10485760

# ── OCR ─────────────────────────────────────────────────────────────────────
# `google` — DEFAULT. Google Cloud Vision, free for the first 1,000 images each
#            month. Reads the printed parts of a cheque; handwriting is left
#            empty for the reviewer. Needs GOOGLE_VISION_KEY_FILE below.
# `claude` — Claude vision. Paid per image, best on Arabic and handwriting.
# `mock`   — synthetic data, reads nothing. Tests and demos only.
#
# Without credentials the API falls back to `mock` and logs a loud warning in
# development; in production it refuses to start rather than serve fake data.
OCR_PROVIDER=google

# -- mock provider --
OCR_MOCK_LATENCY_MS=350
# Deterministic mock output; set a seed to reproduce a specific extraction.
OCR_MOCK_SEED=cheque-flow

# -- claude provider --
# Required when OCR_PROVIDER=claude; the API refuses to start without it.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
OCR_CLAUDE_MODEL=claude-opus-5
OCR_CLAUDE_MAX_TOKENS=8000

# -- google provider --
# Path to a service account JSON key with the "Cloud Vision AI User" role.
# Leave empty to use application default credentials (GOOGLE_APPLICATION_CREDENTIALS
# or `gcloud auth application-default login`).
GOOGLE_VISION_KEY_FILE=

# ── Reminders ───────────────────────────────────────────────────────────────
# Days before the due date at which reminders are scheduled.
REMINDER_OFFSET_DAYS=7,3,1,0
REMINDER_OVERDUE_DAYS=1

# ── Web dashboard (apps/web) ────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3333/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar

# ── Mobile app (apps/mobile) ────────────────────────────────────────────────
# Use your machine's LAN IP when testing on a physical device.
EXPO_PUBLIC_API_URL=http://localhost:3333/api/v1
EXPO_PUBLIC_DEFAULT_LOCALE=ar

# ── Development seed user (local development only) ──────────────────────────
# The seed refuses to run with NODE_ENV=production.
# The sign-in field accepts a user name or an email address. `admin` keeps a
# local install easy to type on a phone; a real deployment must use a proper
# address and a strong password.
SEED_OWNER_EMAIL=admin
SEED_OWNER_PASSWORD=admin
SEED_ORG_NAME=شركة التجارة النموذجية
SEED_ORG_COUNTRY=PS
# The organization's reporting currency. Dashboard and report figures are kept
# separate per currency, so this only decides which one is listed first.
SEED_ORG_CURRENCY=USD
SEED_ORG_TIMEZONE=Asia/Hebron
