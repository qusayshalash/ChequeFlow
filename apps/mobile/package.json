    "@expo/metro-runtime": "~57.0.15",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "5.102.8",
    "expo": "57.0.20",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-file-system": "~57.0.6",
    "expo-image-manipulator": "~57.0.16",
