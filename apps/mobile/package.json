{
  "name": "@cheque-flow/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "build": "expo export --platform all --output-dir dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint app src",
    "test": "vitest run",
    "dev:offline": "expo start --offline",
    "eas-build-post-install": "pnpm --filter \"@cheque-flow/mobile^...\" build"
  },
  "dependencies": {
