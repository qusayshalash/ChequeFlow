    "@cheque-flow/shared-types": "workspace:*",
    "@cheque-flow/ui": "workspace:*",
    "@cheque-flow/validation": "workspace:*",
    "@expo-google-fonts/ibm-plex-sans-arabic": "^0.4.2",
    "@expo/metro-runtime": "~57.0.18",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/query-async-storage-persister": "^5.103.1",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-query-persist-client": "^5.103.1",
    "expo": "57.0.32",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.23",
    "expo-file-system": "~57.0.7",
    "expo-font": "^57.0.4",
