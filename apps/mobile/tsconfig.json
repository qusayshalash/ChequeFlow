{
  "extends": "@cheque-flow/config/tsconfig/react.json",
  "compilerOptions": {
    // No `baseUrl`. SDK 57 pins TypeScript 6, which deprecates it, and the
    // only thing it was doing here was anchoring `paths` — which resolve
    // relative to this file on their own. Silencing the deprecation with
    // `ignoreDeprecations` would have deferred the same removal to TS 7.
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    // `node` is here for the test files only — `theme.contrast.test.ts` reads
    // the theme as text because importing it drags in React Native's
    // Flow-typed entry point. App code that reaches for a node API this
    // permits will still fail loudly at bundle time, which the build check
    // catches; it is not a door into the runtime.
    "types": ["react", "node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
