{
  "extends": "@cheque-flow/config/tsconfig/react.json",
  "compilerOptions": {
    // No `baseUrl`. SDK 57 pins TypeScript 6, which deprecates it, and the
    // only thing it was doing here was anchoring `paths` — which resolve
    // relative to this file on their own. Silencing the deprecation with
    // `ignoreDeprecations` would have deferred the same removal to TS 7.
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "types": ["react"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "app/**/*.ts",
    "app/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ],
  "exclude": ["node_modules", "dist", ".expo"]
}
