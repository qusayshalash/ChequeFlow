# Copy to apps/mobile/.env. Expo reads its environment from this directory, not
# from the repository root.
#
# Both lines are optional in development.
#
# The API address is derived from the Expo dev server the phone loaded the app
# from, so a phone on the same Wi-Fi needs nothing here — and it keeps working
# when the router hands this machine a different address. Set it to point at a
# real server, which is what a production build needs.
# EXPO_PUBLIC_API_URL=https://api.example.com/api/v1
# EXPO_PUBLIC_API_PORT=3333

# EXPO_PUBLIC_DEFAULT_LOCALE=ar
