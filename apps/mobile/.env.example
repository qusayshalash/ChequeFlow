# Copy to apps/mobile/.env. Expo reads its environment from this directory, not
# from the repository root.
#
# Required, and it cannot be localhost: the phone is a different machine, so
# "localhost" there means the phone itself. Use the LAN address of the machine
# running the API, and keep both on the same Wi-Fi network.
EXPO_PUBLIC_API_URL=http://192.168.1.10:3333/api/v1

# EXPO_PUBLIC_DEFAULT_LOCALE=ar
