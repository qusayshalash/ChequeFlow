{
  "expo": {
    "name": "شيك فلو",
    "slug": "cheque-flow",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chequeflow",
    "userInterfaceStyle": "light",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chequeflow.app",
      "infoPlist": {
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لتصوير الشيكات وحفظ صورها في سجل الشركة.",
        "NSFaceIDUsageDescription": "لفتح التطبيق بسرعة وأمان باستخدام البصمة أو التعرف على الوجه."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.chequeflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#087F6D"
      },
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير الشيكات."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "لفتح التطبيق باستخدام التعرف على الوجه."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#087F6D"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    },
    "icon": "./assets/icon.png"
  }
}
