{
  "expo": {
    "name": "شيك فلو",
    "slug": "cheque-flow",
    "owner": "qusayshalash",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "chequeflow",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.chequeflow.app",
      "infoPlist": {
        "NSCameraUsageDescription": "يستخدم التطبيق الكاميرا لتصوير الشيكات وحفظ صورها في سجل الشركة.",
        "NSFaceIDUsageDescription": "لفتح التطبيق بسرعة وأمان باستخدام البصمة أو التعرف على الوجه."
      },
      "buildNumber": "1"
    },
    "android": {
      "package": "com.chequeflow.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#087F6D"
      },
      "permissions": ["CAMERA", "USE_BIOMETRIC", "USE_FINGERPRINT"],
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "يستخدم التطبيق الكاميرا لتصوير الشيكات.",
          "microphonePermission": false,
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "لفتح التطبيق باستخدام التعرف على الوجه."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#087F6D"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/adaptive-icon.png",
          "color": "#087F6D",
          "defaultChannel": "reminders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1dc49cc3-a100-4e81-ac08-51842f555856"
      }
    },
    "icon": "./assets/icon.png"
  }
}
