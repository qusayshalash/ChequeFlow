{
  "name": "@cheque-flow/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src test",
    "test": "jest --config jest.config.js",
    "test:watch": "jest --config jest.config.js --watch",
    "test:e2e": "jest --config jest.e2e.config.js --runInBand",
    "openapi:export": "nest build && node scripts/export-openapi.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.122.0",
    "@aws-sdk/client-s3": "3.1121.0",
    "@aws-sdk/s3-request-presigner": "3.1121.0",
    "@cheque-flow/database": "workspace:*",
    "@cheque-flow/localization": "workspace:*",
    "@cheque-flow/shared-types": "workspace:*",
    "@cheque-flow/validation": "workspace:*",
    "@google-cloud/vision": "6.0.0",
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "argon2": "0.45.1",
    "bullmq": "6.3.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.1"
  },
  "devDependencies": {
    "@cheque-flow/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@swc/core": "1.16.1",
    "@swc/jest": "0.2.39",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/multer": "2.2.0",
    "@types/node": "24.13.3",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.0",
    "supertest": "7.2.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
