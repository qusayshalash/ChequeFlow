# Copy to apps/web/.env. Next reads its environment from this directory, not
# from the repository root.
#
# Both lines are optional.
#
# The API address is derived from the address the page was opened at, so the
# dashboard works from this machine and from a phone on the same Wi-Fi with
# nothing set here. Set it only when the API lives somewhere else — a real
# deployment, or a different port.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
# NEXT_PUBLIC_API_PORT=3333

# NEXT_PUBLIC_DEFAULT_LOCALE=ar
