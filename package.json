{
  "name": "cheque-flow",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @cheque-flow/database generate",
    "db:migrate": "pnpm --filter @cheque-flow/database migrate:dev",
    "db:deploy": "pnpm --filter @cheque-flow/database migrate:deploy",
    "db:seed": "pnpm --filter @cheque-flow/database seed",
    "db:reset": "pnpm --filter @cheque-flow/database reset",
    "infra:up": "docker compose --env-file .env -f infrastructure/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infrastructure/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infrastructure/docker-compose.yml logs -f",
    "infra:reset": "docker compose --env-file .env -f infrastructure/docker-compose.yml down -v"
  },
  "devDependencies": {
    "@cheque-flow/config": "workspace:*",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
