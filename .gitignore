# Regenerated by Next.js on every run; not meant to be tracked.
apps/web/next-env.d.ts

# Throwaway captures. QR codes for opening the app on a phone, and screenshot
# runs taken to compare a screen against a reference — both are regenerated on
# demand and neither is part of the product.
#
# Matched by name rather than by extension on purpose: `*.png` would also
# swallow the app icon and splash screen in apps/mobile/assets, which are
# product files and have to be tracked. Anchored to the repository root, so a
# real asset deeper in the tree cannot be caught by accident.
/*-qr.png
/screenshots/
/*-screenshots-*/

# Playwright
test-results/
playwright-report/

# Service-account and API credentials.
#
# A Google Vision key is a JSON file the console hands you with a name like
# `my-project-4f3a1c9b2d8e.json`, and the natural place to drop it is next to
# the code — which is exactly how a private key ends up in a public history.
# Keep it outside the repository and point GOOGLE_VISION_KEY_FILE at it; these
# patterns are the second line of defence, not the first.
*-key.json
*credential*.json
*service-account*.json
gcp-*.json
secrets/
