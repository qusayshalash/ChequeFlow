// ChequeFlow database schema.
//
// Conventions:
//  - every tenant-scoped table carries `organization_id`;
//  - money is `Decimal(18, 2)` — never a floating point type;
//  - `due_date` / `issue_date` are DATE (calendar dates), all other
//    timestamps are `timestamptz` stored in UTC;
//  - `cheque_events` and `audit_logs` are append-only (enforced by database
//    triggers, see prisma/migrations).

generator client {
  provider = "prisma-client-js"
}

// The connection URL lives in prisma.config.ts (Prisma 7 requirement); the
// runtime client connects through the node-postgres driver adapter.
datasource db {
  provider = "postgresql"
}

enum ChequeDirection {
  INCOMING
  OUTGOING
  TRANSFERRED
}

enum ChequeStatus {
  DRAFT
  PENDING_REVIEW
  IN_HAND
  RESERVED
  DEPOSITED
  TRANSFERRED
  CLEARED
  BOUNCED
  RETURNED
  POSTPONED
  CANCELLED
  LOST
}

enum ChequeEventType {
  CREATED
  RECEIVED
  VERIFIED
  MOVED
  HANDED_OVER
  DEPOSITED
  CLEARED
  BOUNCED
  RETURNED
  POSTPONED
  CANCELLED
  MARKED_LOST
  NOTE_ADDED
  IMAGE_ADDED
  DATA_CORRECTED
}

enum ContactType {
  CUSTOMER
  SUPPLIER
  PERSON
  OTHER
}

enum LocationType {
  SAFE
  DRAWER
  BANK
  EMPLOYEE
  EXTERNAL
}

enum ChequeImageSide {
  FRONT
  BACK
  ATTACHMENT
}

enum OcrStatus {
  NOT_STARTED
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REVIEWED
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DISABLED
}

enum ReminderType {
  BEFORE_DUE
  ON_DUE
  OVERDUE
}

enum ReminderChannel {
  IN_APP
  PUSH
  EMAIL
  WHATSAPP
}

enum ReminderStatus {
  SCHEDULED
  SENT
  FAILED
  CANCELLED
  READ
}

model Organization {
  id              String   @id @default(uuid()) @db.Uuid
  name            String
  country         String   @db.Char(2)
  defaultCurrency String   @map("default_currency") @db.Char(3)
  timezone        String   @default("UTC")
  settingsJson    Json     @default("{}") @map("settings_json")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  branches     Branch[]
  users        User[]
  roles        Role[]
  contacts     Contact[]
  bankAccounts BankAccount[]
  locations    Location[]
  cheques      Cheque[]
  auditLogs    AuditLog[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  code           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  locations    Location[]
  cheques      Cheque[]
  bankAccounts BankAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("branches")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @map("organization_id") @db.Uuid
  branchId       String?    @map("branch_id") @db.Uuid
  name           String
  email          String
  phone          String?
  passwordHash   String     @map("password_hash")
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch        Branch?        @relation(fields: [branchId], references: [id], onDelete: SetNull)
  userRoles     UserRole[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  createdCheques  Cheque[] @relation("ChequeCreatedBy")
  reviewedCheques Cheque[] @relation("ChequeReviewedBy")
  heldCheques     Cheque[] @relation("ChequeCurrentHolder")

  performedEvents ChequeEvent[] @relation("EventPerformedBy")
  approvedEvents  ChequeEvent[] @relation("EventApprovedBy")
  eventsFromUser  ChequeEvent[] @relation("EventFromUser")
  eventsToUser    ChequeEvent[] @relation("EventToUser")

  uploadedImages ChequeImage[] @relation("ImageUploadedBy")
  reminders      Reminder[]

  @@unique([organizationId, email])
  @@index([organizationId])
  @@index([email])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  description    String?
  isSystem       Boolean  @default(false) @map("is_system")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  description String
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  /// SHA-256 of the refresh token; the raw token is never persisted.
  tokenHash      String    @unique @map("token_hash")
  /// Rotation family: revoking one member revokes the whole chain.
  familyId       String    @map("family_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  replacedByHash String?   @map("replaced_by_hash")
  userAgent      String?   @map("user_agent")
  ipAddress      String?   @map("ip_address")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model Contact {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  type           ContactType
  name           String
  companyName    String?     @map("company_name")
  phone          String?
  email          String?
  taxNumber      String?     @map("tax_number")
  nationalId     String?     @map("national_id")
  address        String?
  notes          String?
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  sourcedCheques   Cheque[] @relation("ChequeOriginalSource")
  receivedCheques  Cheque[] @relation("ChequeCurrentRecipient")
  eventsFromContact ChequeEvent[] @relation("EventFromContact")
  eventsToContact   ChequeEvent[] @relation("EventToContact")

  @@index([organizationId, type])
  @@index([organizationId, name])
  @@map("contacts")
}

model Bank {
  id      String  @id @default(uuid()) @db.Uuid
  country String  @db.Char(2)
  name    String
  code    String
  logoUrl String? @map("logo_url")

  bankAccounts BankAccount[]
  cheques      Cheque[]

  @@unique([country, code])
  @@map("banks")
}

model BankAccount {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  bankId                 String   @map("bank_id") @db.Uuid
  branchId               String?  @map("branch_id") @db.Uuid
  accountName            String   @map("account_name")
  /// AES-256-GCM ciphertext; never returned unmasked in API responses.
  accountNumberEncrypted String   @map("account_number_encrypted")
  ibanEncrypted          String?  @map("iban_encrypted")
  currency               String   @db.Char(3)
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bank         Bank         @relation(fields: [bankId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("bank_accounts")
}

model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  branchId       String?      @map("branch_id") @db.Uuid
  type           LocationType
  name           String
  description    String?
  isActive       Boolean      @default(true) @map("is_active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  cheques           Cheque[]      @relation("ChequeCurrentLocation")
  eventsFromLocation ChequeEvent[] @relation("EventFromLocation")
  eventsToLocation   ChequeEvent[] @relation("EventToLocation")

  @@index([organizationId, type])
  @@map("locations")
}

model Cheque {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  branchId       String?         @map("branch_id") @db.Uuid
  direction      ChequeDirection
  chequeNumber   String          @map("cheque_number")
  amount         Decimal         @db.Decimal(18, 2)
  /// The amount as written in letters on the cheque face. Kept verbatim for
  /// dispute resolution: in most jurisdictions the written amount prevails.
  amountInWords  String?         @map("amount_in_words")
  currency       String          @db.Char(3)
  issueDate      DateTime?       @map("issue_date") @db.Date
  dueDate        DateTime        @map("due_date") @db.Date
  receivedDate   DateTime?       @map("received_date") @db.Date

  bankId                 String? @map("bank_id") @db.Uuid
  bankNameRaw            String? @map("bank_name_raw")
  bankBranchRaw          String? @map("bank_branch_raw")
  accountNumberEncrypted String? @map("account_number_encrypted")
  drawerName             String? @map("drawer_name")

  originalSourceId    String? @map("original_source_id") @db.Uuid
  originalPayeeName   String? @map("original_payee_name")
  currentHolderId     String? @map("current_holder_id") @db.Uuid
  currentRecipientId  String? @map("current_recipient_id") @db.Uuid
  currentLocationId   String? @map("current_location_id") @db.Uuid

  status          ChequeStatus @default(DRAFT)
  /// Reason the bank gave for refusing payment, and the fee it charged.
  /// Both stay on the cheque after it is re-presented or returned.
  bounceReason    String?      @map("bounce_reason")
  bounceFee       Decimal?     @map("bounce_fee") @db.Decimal(18, 2)
  purpose         String?
  referenceNumber String?      @map("reference_number")
  notes           String?

  ocrStatus             OcrStatus @default(NOT_STARTED) @map("ocr_status")
  ocrOverallConfidence  Decimal?  @map("ocr_overall_confidence") @db.Decimal(5, 4)

  createdBy  String?   @map("created_by") @db.Uuid
  reviewedBy String?   @map("reviewed_by") @db.Uuid
  reviewedAt DateTime? @map("reviewed_at") @db.Timestamptz(3)

  /// Optimistic locking counter, incremented on every write.
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch           Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  bank             Bank?        @relation(fields: [bankId], references: [id], onDelete: SetNull)
  originalSource   Contact?     @relation("ChequeOriginalSource", fields: [originalSourceId], references: [id], onDelete: SetNull)
  currentRecipient Contact?     @relation("ChequeCurrentRecipient", fields: [currentRecipientId], references: [id], onDelete: SetNull)
  currentHolder    User?        @relation("ChequeCurrentHolder", fields: [currentHolderId], references: [id], onDelete: SetNull)
  currentLocation  Location?    @relation("ChequeCurrentLocation", fields: [currentLocationId], references: [id], onDelete: SetNull)
  creator          User?        @relation("ChequeCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  reviewer         User?        @relation("ChequeReviewedBy", fields: [reviewedBy], references: [id], onDelete: SetNull)

  images         ChequeImage[]
  events         ChequeEvent[]
  ocrExtractions OcrExtraction[]
  reminders      Reminder[]

  @@index([organizationId, status])
  @@index([organizationId, dueDate])
  @@index([organizationId, direction])
  @@index([organizationId, chequeNumber])
  @@index([organizationId, branchId])
  @@index([organizationId, originalSourceId])
  @@index([organizationId, currentLocationId])
  // Business key used by the duplicate detector.
  @@index([organizationId, bankId, chequeNumber, amount, dueDate], name: "cheques_duplicate_key_idx")
  @@map("cheques")
}

model ChequeImage {
  id         String          @id @default(uuid()) @db.Uuid
  chequeId   String          @map("cheque_id") @db.Uuid
  side       ChequeImageSide
  storageKey String          @map("storage_key")
  mimeType   String          @map("mime_type")
  fileSize   Int             @map("file_size")
  /// SHA-256 of the raw bytes, used for duplicate detection.
  imageHash  String          @map("image_hash")
  capturedAt DateTime?       @map("captured_at") @db.Timestamptz(3)
  uploadedBy String?         @map("uploaded_by") @db.Uuid
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  cheque   Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  uploader User?  @relation("ImageUploadedBy", fields: [uploadedBy], references: [id], onDelete: SetNull)

  @@unique([chequeId, side, imageHash])
  @@index([chequeId])
  @@index([imageHash])
  @@map("cheque_images")
}

model OcrExtraction {
  id                  String    @id @default(uuid()) @db.Uuid
  chequeId            String    @map("cheque_id") @db.Uuid
  provider            String
  providerRequestId   String?   @map("provider_request_id")
  rawResultJson       Json      @map("raw_result_json")
  extractedFieldsJson Json      @map("extracted_fields_json")
  confidenceJson      Json      @map("confidence_json")
  processingStatus    OcrStatus @default(PENDING) @map("processing_status")
  errorMessage        String?   @map("error_message")
  processedAt         DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  cheque Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)

  @@index([chequeId])
  @@map("ocr_extractions")
}

/// Append-only ledger of everything that happened to a cheque.
/// UPDATE and DELETE are blocked by a database trigger.
model ChequeEvent {
  id             String          @id @default(uuid()) @db.Uuid
  chequeId       String          @map("cheque_id") @db.Uuid
  eventType      ChequeEventType @map("event_type")
  fromStatus     ChequeStatus?   @map("from_status")
  toStatus       ChequeStatus?   @map("to_status")
  fromContactId  String?         @map("from_contact_id") @db.Uuid
  toContactId    String?         @map("to_contact_id") @db.Uuid
  fromUserId     String?         @map("from_user_id") @db.Uuid
  toUserId       String?         @map("to_user_id") @db.Uuid
  fromLocationId String?         @map("from_location_id") @db.Uuid
  toLocationId   String?         @map("to_location_id") @db.Uuid
  eventDate      DateTime        @default(now()) @map("event_date") @db.Timestamptz(3)
  notes          String?
  proofAttachmentId String?      @map("proof_attachment_id") @db.Uuid
  performedBy    String?         @map("performed_by") @db.Uuid
  approvedBy     String?         @map("approved_by") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  cheque       Cheque    @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  fromContact  Contact?  @relation("EventFromContact", fields: [fromContactId], references: [id], onDelete: SetNull)
  toContact    Contact?  @relation("EventToContact", fields: [toContactId], references: [id], onDelete: SetNull)
  fromUser     User?     @relation("EventFromUser", fields: [fromUserId], references: [id], onDelete: SetNull)
  toUser       User?     @relation("EventToUser", fields: [toUserId], references: [id], onDelete: SetNull)
  fromLocation Location? @relation("EventFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocation   Location? @relation("EventToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  performer    User?     @relation("EventPerformedBy", fields: [performedBy], references: [id], onDelete: SetNull)
  approver     User?     @relation("EventApprovedBy", fields: [approvedBy], references: [id], onDelete: SetNull)

  @@index([chequeId, createdAt])
  @@index([eventType])
  @@map("cheque_events")
}

model Reminder {
  id              String          @id @default(uuid()) @db.Uuid
  chequeId        String          @map("cheque_id") @db.Uuid
  type            ReminderType
  remindAt        DateTime        @map("remind_at") @db.Timestamptz(3)
  channel         ReminderChannel @default(IN_APP)
  recipientUserId String?         @map("recipient_user_id") @db.Uuid
  status          ReminderStatus  @default(SCHEDULED)
  /// Set by a person rather than by the due-date schedule. Custom reminders
  /// survive a reschedule; automatic ones are recomputed whenever the cheque
  /// moves or its due date changes.
  custom          Boolean         @default(false)
  note            String?
  sentAt          DateTime?       @map("sent_at") @db.Timestamptz(3)
  acknowledgedAt  DateTime?       @map("acknowledged_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  cheque    Cheque @relation(fields: [chequeId], references: [id], onDelete: Cascade)
  recipient User?  @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)

  @@index([chequeId])
  @@index([status, remindAt])
  @@index([recipientUserId, status])
  @@map("reminders")
}

/// Append-only audit trail. UPDATE and DELETE are blocked by a trigger.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  ipAddress      String?  @map("ip_address")
  deviceInfo     String?  @map("device_info")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
