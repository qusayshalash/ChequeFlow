{
  "name": "@cheque-flow/ui",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@cheque-flow/shared-types": "workspace:*",
    "clsx": "2.1.1"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@cheque-flow/config": "workspace:*",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "react": "19.2.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
