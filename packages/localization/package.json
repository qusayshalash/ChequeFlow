{
  "name": "@cheque-flow/localization",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/ar": "./src/messages/ar.json",
    "./messages/en": "./src/messages/en.json"
  },
  "files": [
    "dist",
    "src/messages"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/copy-messages.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cheque-flow/config": "workspace:*",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
